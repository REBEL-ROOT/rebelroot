SENDGRID_API_KEY=your_sendgrid_api_key
NEXT_PUBLIC_TINA_CLIENT_ID=
NEXT_PUBLIC_EDIT_BRANCH="main"
NEXT_PUBLIC_ORGANIZATION_NAME=
NEXT_PUBLIC_USE_LOCAL_CLIENT=""

# Turso DB Configuration (libSQL Edge Database)
TURSO_DATABASE_URL=libsql://your-db-instance.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# LinkedIn Company Profile Automation API Configuration
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ORGANIZATION_ID=your_organization_id
LINKEDIN_ACCESS_TOKEN=your_access_token

# Groq AI API Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL="qwen/qwen3.6-27b"

# Admin Authentication
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password